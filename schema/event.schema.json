        },
        "actor": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d",
          "description": "when it happened; absent only on events upgraded from logs written before events had identity (actor 'legacy')"
        },
